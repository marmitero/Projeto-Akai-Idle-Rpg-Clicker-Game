{
  "name": "projeto-akai",
  "version": "0.1.0",
  "private": true,
  "description": "Projeto Akai - Idle RPG Clicker Game (monorepo)",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/shared",
    "apps/server",
    "apps/client"
  ],
  "scripts": {
    "build": "npm run build -w @akai/shared && npm run build -w @akai/server && npm run build -w @akai/client",
    "dev": "node tools/dev.mjs",
    "dev:server": "npm run dev -w @akai/server",
    "dev:client": "npm run dev -w @akai/client",
    "test": "vitest run",
    "typecheck": "tsc -b packages/shared apps/server apps/client"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
